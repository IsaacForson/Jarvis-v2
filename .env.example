# Copy to .env and paste your NVIDIA API keys, separated by commas. .env is never committed.
NVIDIA_API_KEYS=nvapi-first,nvapi-second
# Optional: Groq keys, the same way. With them, conversation and simple actions are answered by Groq (much faster); NVIDIA does the rest.
GROQ_API_KEYS=gsk_first,gsk_second
# 1: act without asking first, except deleting (payments, passwords and card numbers are still refused)
JARVIS_AUTONOMOUS=1
# When the morning briefing is spoken, HH:MM (default 08:00)
JARVIS_BRIEFING_TIME=08:00
# When the evening recap is spoken, HH:MM (default 21:00)
JARVIS_RECAP_TIME=21:00
# Optional work tools. Slack: a user token (xoxp-...) with search:read and chat:write. Jira: site, account email and an API token.
# SLACK_TOKEN=
# JIRA_SITE=https://yourname.atlassian.net
# JIRA_EMAIL=
# JIRA_TOKEN=
# Where your code projects live (default ~/Desktop/PROJECTS)
# JARVIS_PROJECTS_DIR=
