{
  "name": "jarvis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "speed": "node --env-file=.env src/speed-test.ts",
    "voice": "node src/voice-test.ts",
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "allow-wake": "sh scripts/allow-wake.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@ricky0123/vad-web": "^0.0.31",
    "kokoro-js": "^1.2.1",
    "openai": "^7.55.0",
    "playwright-core": "^1.65.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "electron": "^45.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "main": "dist/main.js"
}
